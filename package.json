{
  "name": "trsr-video",
  "private": true,
  "version": "0.9.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run build && npm run server",
    "server": "npm run start -w @trsr-video/server",
    "dev": "npm run dev -w @trsr-video/web",
    "build": "npm run build -w @trsr-video/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/server --noEmit",
    "golden": "node tools/make-golden.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "description": "AI video studio: build the film, pick the platform and model, see the cost, generate."
}

# Copy to .env (or save the keys in the app's Settings screen, which writes this file for you).
# Never commit .env.

# Video providers (fill only the ones you use)
RUNWARE_API_KEY=
# Higgsfield: the key id and the secret joined by a colon
HIGGSFIELD_API_KEY=
RUNWAYML_API_SECRET=
PIKA_API_KEY=
KREA_API_KEY=
XAI_API_KEY=
LTX_API_KEY=
KLING_API_KEY=
GEMINI_API_KEY=

# Optional spending limits in USD; above them the app asks for a second confirmation
LIMIT_PER_GENERATION_USD=
LIMIT_PER_DAY_USD=

# Server
PORT=4477
HOST=127.0.0.1
DATA_DIR=data
